# /etc/sandbox-bench/env — owned by root, mode 0600. Loaded by sandbox-bench.service.
SBX_HOME=/home/sbx/sandbox-bench
SBX_RESULTS=/home/sbx/sandbox-bench-results
SBX_PROVIDERS=daytona,freestyle
SBX_RUNNER_REGION=us-east

# Provider credentials: one line per key the adapters read.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
FREESTYLE_API_KEY=
